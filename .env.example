# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Qdrant 
# For local Docker: http://localhost:6333 (leave QDRANT_API_KEY empty)
# For Qdrant Cloud free tier: use your cluster URL + API key
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# App settings
COLLECTION_NAME=pdf_docs
DATA_DIR=data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
MIN_SCORE=0.30
